<Window x:Class="CodexQuotaMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Quota Monitor Native"
        Width="260"
        Height="48"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Icon="Assets/CodexQuotaMonitor.ico"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing"
        MouseRightButtonUp="OnMouseRightButtonUp">
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="DesignSurface" Width="260" Height="48">
            <Border x:Name="OuterBorder" Margin="1" CornerRadius="8" BorderThickness="0.75">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
                        <GradientStop Color="#70405364" Offset="0" />
                        <GradientStop Color="#881E2D3C" Offset="0.48" />
                        <GradientStop Color="#9617222F" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                        <GradientStop Color="#8CE8F5FF" Offset="0" />
                        <GradientStop Color="#456F94AD" Offset="0.55" />
                        <GradientStop Color="#5089AABD" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <!-- Rounded overlays keep all highlights inside the transparent silhouette. -->
                    <Border Margin="0.5" CornerRadius="7" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#18FFFFFF" Offset="0" />
                                <GradientStop Color="#04D9EFFF" Offset="0.42" />
                                <GradientStop Color="#00FFFFFF" Offset="0.62" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid x:Name="RootGrid" Margin="3,2,3,2" />
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</Window>
