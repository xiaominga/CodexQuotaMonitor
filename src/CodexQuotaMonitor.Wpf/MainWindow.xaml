<Window x:Class="CodexQuotaMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:CodexQuotaMonitor.Wpf"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Quota Monitor Native"
        Width="124"
        Height="48"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Icon="Assets/CodexQuotaMonitor.ico"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing"
        MouseRightButtonUp="OnMouseRightButtonUp">
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="DesignSurface" Width="124" Height="48" UseLayoutRounding="False" SnapsToDevicePixels="False">
            <local:QuotaCardFrame x:Name="CardFrame" />
            <Grid x:Name="RootGrid" Margin="1.65" />
        </Grid>
    </Viewbox>
</Window>
